/* Popup overlay styles */
#popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

#popup-container {
    background-color: rgba(25, 25, 45, 0.98);
    border-radius: 25px;
    padding: 40px 50px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.8);
    min-width: 350px;
    align-items: center;
}

#winner-label {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

#score-label {
    font-size: 18px;
    color: rgba(230, 230, 230, 1);
    margin-bottom: 30px;
    -unity-text-align: middle-center;
}

#new-game-button {
    background-color: rgba(51, 179, 51, 1);
    color: white;
    border-radius: 12px;
    padding: 18px 40px;
    font-size: 18px;
    -unity-font-style: bold;
    border-width: 0;
    min-width: 150px;
    min-height: 50px;
}

#new-game-button:hover {
    background-color: rgba(26, 153, 26, 1);
    transform: scale(1.05);
}

#new-game-button:active {
    background-color: rgba(0, 128, 0, 1);
    transform: scale(0.98);
}