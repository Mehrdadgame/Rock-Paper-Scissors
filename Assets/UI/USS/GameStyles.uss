/* Main game container */
.game-container {
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 20px;
    background-color: rgba(0, 20, 40, 0.9);
}

/* Score display styles */
.score-container {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 20px;
}

.score-label {
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}

/* Choice display styles */
.choices-container {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    justify-content: space-around;
    width: 100%;
}

.choice-image {
    width: 120px;
    height: 120px;
    border-radius: 15px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.8);
    background-color: rgba(255, 255, 255, 0.1);
    transition-duration: 0.3s;
}

/* Button styles */
.buttons-container {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-top: 20px;
}

.choice-button {
    width: 80px;
    height: 80px;
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.6);
    background-color: rgba(255, 255, 255, 0.1);
    transition-duration: 0.2s;
}

.choice-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
    border-color: rgba(255, 255, 255, 0.9);
}

.choice-button:active {
    background-color: rgba(255, 255, 255, 0.3);
    transform: scale(0.95);
}

/* Result text styles */
.result-label {
    font-size: 22px;
    color: white;
    -unity-font-style: bold;
    margin: 20px 0;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.7);
}

/* Reset button styles */
.reset-button {
    background-color: #4CAF50;
    color: white;
    border-radius: 8px;
    padding: 12px 24px;
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
}

.reset-button:hover {
    background-color: #45a049;
    transform: scale(1.05);
}